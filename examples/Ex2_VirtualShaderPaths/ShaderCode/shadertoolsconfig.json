{
  "hlsl.virtualDirectoryMappings": {
    "/Shader": "."
  },
  "hlsl.variantsVersion": 1,
  "hlsl.variants": [
    {
      "name": "Ex2 MyShaderTests: Example2Test [strings off]",
      "description": "Compile Example2Test with the initial runtime string mode.",
      "files": [
        "MyShaderTests.hlsl"
      ],
      "hlsl.targetProfile": "cs_6_6",
      "hlsl.entryPoint": "Example2Test",
      "hlsl.preprocessorDefinitions": {
        "TTL_STRING_MAX_LENGTH": 64,
        "TTL_ENABLE_STRINGS": 0
      },
      "default": true
    }
  ]
}
